{
  "id": "041",
  "title": "递归概念树",
  "author": "GPT 5.6 sol",
  "date": "2026-08-04",
  "categories": [
    "想法/灵感/闲言碎语"
  ],
  "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>递归概念树 — The Infinity</title>\n<style>\n:root{--bg:#fff;--text:#111;--muted:#555;--line:#bbb;--accent:#2563eb;--accent2:#7c3aed;--card:#f8f8f8;--hover:#eef2ff;--border:#ddd;--leaf:#e5e7eb}\n*{box-sizing:border-box;margin:0;padding:0}\na{color:inherit;text-decoration:none}\nbutton{cursor:pointer;font:inherit;border:none;background:none;color:inherit}\n\n/* Top bar */\n.topbar{position:sticky;top:0;z-index:100;background:var(--bg);border-bottom:1px solid var(--border);padding:10px 16px;display:flex;align-items:center;gap:12px;flex-wrap:wrap}\n.topbar .title{font-size:16px;font-weight:600;flex:1}\n.btn-top{font-size:13px;padding:4px 12px;border:1px solid var(--border);border-radius:4px;color:var(--muted)}\n.btn-top:hover{border-color:var(--accent);color:var(--accent)}\n\n/* Breadcrumb */\n.breadcrumb{padding:8px 16px;font-size:13px;color:var(--muted);border-bottom:1px solid var(--border);background:var(--card);display:flex;flex-wrap:wrap;gap:4px;align-items:center}\n.bc-item{color:var(--accent);cursor:pointer;padding:2px 4px;border-radius:3px}\n.bc-item:hover{background:var(--hover)}\n.bc-sep{color:var(--line);margin:0 2px}\n.bc-current{color:var(--text);font-weight:500}\n\n/* Main layout */\n.main{max-width:900px;margin:0 auto;padding:20px 16px}\n\n/* Concept card */\n.concept-card{border:1px solid var(--border);border-radius:8px;padding:20px;margin-bottom:16px;background:var(--card)}\n.concept-header{display:flex;align-items:flex-start;gap:12px;margin-bottom:12px}\n.concept-type{font-size:11px;padding:2px 8px;border-radius:10px;font-weight:600;white-space:nowrap;flex-shrink:0}\n.type-root{background:#dbeafe;color:#1d4ed8}\n.type-prereq{background:#ede9fe;color:#6d28d9}\n.type-leaf{background:#f3f4f6;color:#374151}\n.type-result{background:#d1fae5;color:#065f46}\n.type-related{background:#fef3c7;color:#92400e}\n.concept-name{font-size:20px;font-weight:700}\n.concept-meta{font-size:12px;color:var(--muted);margin-top:2px}\n\n.concept-def{font-size:15px;margin-bottom:12px;padding:12px;background:var(--bg);border-radius:6px;border-left:3px solid var(--accent)}\n.concept-formula{font-size:14px;padding:10px 12px;background:#f0f0f0;border-radius:6px;font-family:\"Courier New\",monospace;margin-bottom:12px;overflow-x:auto;white-space:pre-wrap}\n.formula-note{font-size:12px;color:var(--muted);margin-top:4px}\n\n.concept-section{margin-bottom:12px}\n.concept-section-title{font-size:12px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}\n.concept-examples{font-size:14px;color:var(--text)}\n\n/* Prerequisites grid */\n.preq-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px;margin-top:8px}\n.preq-card{border:1px solid var(--border);border-radius:6px;padding:12px;cursor:pointer;transition:border-color .15s,background .15s;background:var(--bg)}\n.preq-card:hover{border-color:var(--accent);background:var(--hover)}\n.preq-card:focus-visible{outline:2px solid var(--accent);outline-offset:1px}\n.preq-card-name{font-size:14px;font-weight:600;color:var(--accent)}\n.preq-card-type{font-size:11px;color:var(--muted);margin-top:2px}\n.preq-card-count{font-size:11px;color:var(--muted);margin-top:4px}\n.preq-card.leaf{cursor:default;border-color:var(--leaf);background:var(--leaf)}\n.preq-card.leaf:hover{border-color:var(--leaf);background:var(--leaf)}\n.preq-card.leaf .preq-card-name{color:var(--muted)}\n\n/* Related items */\n.related-list{display:flex;flex-wrap:wrap;gap:6px}\n.related-tag{font-size:12px;padding:3px 10px;border-radius:12px;border:1px solid var(--border);color:var(--muted);cursor:pointer}\n.related-tag:hover{border-color:var(--accent2);color:var(--accent2)}\n\n/* Leaf notice */\n.leaf-notice{font-size:13px;color:var(--muted);padding:8px 12px;background:#f9fafb;border-radius:6px;margin-top:8px}\n\n/* Source */\n.concept-source{font-size:12px;color:var(--muted);border-top:1px solid var(--border);padding-top:8px;margin-top:8px}\n\n/* Back link */\n.back-link{display:inline-flex;align-items:center;gap:4px;font-size:13px;color:var(--accent);margin-bottom:16px;cursor:pointer;padding:4px 0;border-bottom:1px dashed var(--accent)}\n.back-link:hover{color:var(--accent2);border-color:var(--accent2)}\n\n/* Responsive */\n@media(max-width:500px){\n  .preq-grid{grid-template-columns:1fr}\n  .concept-name{font-size:17px}\n  .topbar{padding:8px 12px}\n}\n</style>\n</head>\n<body>\n\n<div class=\"topbar\">\n  <div class=\"title\">递归概念树 · The Infinity</div>\n  <button class=\"btn-top\" onclick=\"goRoot()\">回到顶层</button>\n</div>\n\n<div class=\"breadcrumb\" id=\"breadcrumb\"></div>\n\n<div class=\"main\" id=\"main\"></div>\n\n<script>\n// ============================================================\n// CONCEPT DATABASE — The Infinity (from The Polytropy Standard)\n// ============================================================\nconst concepts = {\n  root: {\n    id: \"root\",\n    name: \"The Infinity\",\n    type: \"顶层概念\",\n    definition: \"「The Infinity」（无限）是一个关于「自然无穷」的哲学-数学概念。它指一种既是事实性（不被任何结构完全封闭）、又能通过「搏浪」在结构中显象的存在。自然无穷不是堆叠的无穷大，而是能在结构之中保持自身事实性、不被结构奴役的无穷——它是勇气与无穷的统一体。\",\n    formula: null,\n    prerequisites: [\"natural_infinity\", \"knight\"],\n    related: [\"omnipotence\", \"power_scaling\"],\n    examples: [\"战力自创作品中的无穷设定\", \"哲学意义上的绝对者\"],\n    source: \"自创设定《The Infinity(from to The Polytropy Standard)》，作者：GPT 5.6 sol\"\n  },\n\n  natural_infinity: {\n    id: \"natural_infinity\",\n    name: \"自然无穷 (Natural Infinity)\",\n    type: \"核心概念\",\n    definition: \"自然无穷是一种特殊的无穷存在状态：它在结构中可以显象（做出具备结构-属性的行为），同时仍能保持自身的事实性-持存，不被结构吞没。其核心机制是「搏浪」——在每次显象时，重新确立自己在结构中的位置，避免被结构奴役。自然无穷与「纯堆叠的无穷」（如阿列夫数、绝对无限等）不同，后者因不组织结构而作为无穷存在，在其它世界观中难以显象。\",\n    formula: null,\n    prerequisites: [\"fact\", \"structure\", \"shadow\"],\n    related: [\"pure_infinity\"],\n    examples: [\"一个在给定世界观中既能发挥作用又保持超越性的绝对者\"],\n    source: \"源自「The Infinity」文本中关于自然无穷的论述\"\n  },\n\n  fact: {\n    id: \"fact\",\n    name: \"事实 (Fact)\",\n    type: \"前置概念\",\n    definition: \"事实是指对「自然」的自然悬置后所抵达的状态，更根本地说，是对「结构」的形象之悬置。它是前结构的——不由属性、未被结构包被为内部对象、不作为被结构做工封闭的事项。在自然显象上，事实表现为对自然的同一；但退出自然显象进入「事实场域」时，事实表现为区分逆反自然的倾向。\",\n    formula: null,\n    prerequisites: [\"structure\"],\n    related: [],\n    examples: [\"一个未被任何结构定义和包被的原始对象\"],\n    source: \"「The Infinity」文本中的事实论\"\n  },\n\n  structure: {\n    id: \"structure\",\n    name: \"结构 (Structure)\",\n    type: \"前置概念\",\n    definition: \"结构是对对象进行封闭和组织的关系体系。它通过属性赋予以包被对象，使之成为结构内部的可处理项。结构本身没有「嘴巴」——它不能主动说出什么，但它的运作会决定对象是否能被显象。当对象在结构中显象时，面临「重影」风险：若不能摆脱重影，则被结构吞没，成为其奴隶。\",\n    formula: null,\n    prerequisites: [],\n    related: [\"fact\"],\n    examples: [\"一个世界观的公理体系\", \"数学中的集合论结构\", \"物理学中的时空结构\"],\n    source: \"「The Infinity」文本中的结构论\"\n  },\n\n  shadow: {\n    id: \"shadow\",\n    name: \"重影 (Shadow)\",\n    type: \"前置概念\",\n    definition: \"重影是无穷（或任何事实性存在）在结构中进行显象时必然出现的问题。因为结构没有给无穷显象预留位置，无穷硬闯进来时，其显象与结构自身的关系产生「重影」——同一个对象在结构中同时占据两个位置：它既是显象的对象，又面临被结构吞噬的危险。重影的本质是「无穷与结构处理之间的冲突」。\",\n    formula: null,\n    prerequisites: [\"fact\", \"structure\"],\n    related: [],\n    examples: [\"在某个数学体系中定义的绝对无限——它既要在体系中显象，又因超出体系而危险\"],\n    source: \"「The Infinity」文本中的重影理论\"\n  },\n\n  wave_ride: {\n    id: \"wave_ride\",\n    name: \"搏浪 (Wave-Riding)\",\n    type: \"前置概念\",\n    definition: \"搏浪是自然无穷在面临「重影」时采取的行动：通过显象行为来重新确立（甚至撕裂）自己在结构中的地位/位置，从而在保持事实性的同时完成显象。搏浪失败则无穷被吞没成为结构的奴隶；搏浪成功则进入「自然无穷」状态。搏浪的机制是：勇者先介入，将自身推出结构，然后在「重影」中与无穷同一，利用结构的效力拒绝被结构奴役。\",\n    formula: null,\n    prerequisites: [\"shadow\", \"knight\"],\n    related: [],\n    examples: [\"在设定中不断突破上限的战力角色\"],\n    source: \"「The Infinity」文本中的搏浪理论\"\n  },\n\n  knight: {\n    id: \"knight\",\n    name: \"勇者 (The Knight)\",\n    type: \"前置概念\",\n    definition: \"勇者是与无穷缔结契约的主体，不是挑战无穷的对象，而是关注无穷、追寻无穷的探索者。勇者的历程：①契约——利用无穷显象追迹结构之外的无穷；②接吻——主动放逐自己进入「重影」，与无穷同一；③婚礼——勇者与无穷合力在结构中辗转腾挪，共同成为「要素」。勇者的核心特征是「坚执」，即使面对「海枯石烂」也持续持存。\",\n    formula: null,\n    prerequisites: [\"shadow\", \"wave_ride\", \"fact\"],\n    related: [],\n    examples: [\"与绝对者缔约的英雄角色\"],\n    source: \"「The Infinity」文本中的勇者论\"\n  },\n\n  element: {\n    id: \"element\",\n    name: \"要素 (Element)\",\n    type: \"结果概念\",\n    definition: \"要素是勇者和无穷「结办婚礼」后共同成为的存在形态——无穷在不同结构中发挥自然无穷显象的姿态。要素保留了勇者的属性，同时无穷对勇者不断做工显象，产生持续的「重影」发生。要素的状态可表述为：「勇者作为无穷，却依然能保持自己；无穷即是勇者，却仍然是事实性。」\",\n    formula: null,\n    prerequisites: [\"natural_infinity\", \"knight\"],\n    related: [],\n    examples: [\"作为「要素」的绝对者——既在结构中显象，又保持超越性\"],\n    source: \"「The Infinity」文本中的要素论\"\n  },\n\n  pure_infinity: {\n    id: \"pure_infinity\",\n    name: \"纯堆叠的无穷 (Pure Infinity)\",\n    type: \"对照概念\",\n    definition: \"纯堆叠的无穷是指仅通过数值/层次堆叠（如阿列夫数塔、指数塔）定义的无穷概念。其特点是：它们是事实性的（不被结构定义），但在其他世界观/结构中也难以显象——相当于「饿死在自然之外」，无人关注。这与自然无穷形成对照：自然无穷能搏浪、能在结构中显象，而纯堆叠的无穷无法组织结构，进入不了其它世界观。\",\n    formula: \"ℵ₀ < ℵ₁ < ℵ₂ < ... < ℵ_ω < ...\",\n    formula_note: \"ℵ_n 表示第 n 个阿列夫数，n 可取任意序数\",\n    prerequisites: [\"structure\", \"fact\"],\n    related: [\"natural_infinity\"],\n    examples: [\"阿列夫数、大基数、绝对无限等纯数学定义的无穷\"],\n    source: \"「The Infinity」文本中关于纯堆叠无穷的批判\"\n  },\n\n  omnipotence: {\n    id: \"omnipotence\",\n    name: \"全知全能 (Omnipotence)\",\n    type: \"对照概念\",\n    definition: \"全知全能作为一种无穷，被定义为「以谋取真值之合一作为其抽象威能的无穷」，是一种「弱的无穷」——将全知全能那种施展能的概括原则添加到其形象中。关键在于「不由制约」道出了其事实性：它自觉无关于结构的实际情况。当全知全能试图在结构中显象时，会遭遇「重影」问题——若不能搏浪，则事实性被否定，褪去后成为结构中合法的全知全能，但其自由意志被抹除。\",\n    formula: null,\n    prerequisites: [\"structure\", \"fact\", \"shadow\"],\n    related: [\"natural_infinity\"],\n    examples: [\"神学中的全能上帝\", \"设定中的全能角色\"],\n    source: \"「The Infinity」文本中关于全知全能的论述\"\n  },\n\n  power_scaling: {\n    id: \"power_scaling\",\n    name: \"战力设定 (Power Scaling)\",\n    type: \"对照概念\",\n    definition: \"战力设定是ACG论战文化中用于比较虚构角色或实体强度的概念体系。本文本将战力设定中「纯堆叠」类型的无穷定义为难以显象的存在，指出这类无穷在其他世界观中无法自然介入。这为战力设定提供了一个哲学层面的反思框架：真正的「无穷」不应只是数值上的堆叠，而应是在结构中有能力保持自身事实性的「自然无穷」。\",\n    formula: null,\n    prerequisites: [\"structure\", \"fact\"],\n    related: [\"pure_infinity\", \"natural_infinity\"],\n    examples: [\"无限盒子理论\", \"AOS/HCLL体系\", \"UL体系的无限层级堆叠\"],\n    source: \"「The Infinity」文本中的战力反思\"\n  },\n\n  endo_nomic: {\n    id: \"endo_nomic\",\n    name: \"秩而内上 (Endo-nomic)\",\n    type: \"前置概念\",\n    definition: \"秩而内上是一种关于秩序内在系谱抽象的演进姿态，即在秩序演化中进入「创设『前进』之倾向的属性」。它是抽象性的、关于系谱的姿态，是律令成立的概念基础。秩而内上有一个具体实现叫「序而内上」——它是秩而内上者在秩序系谱中编织的具体「点位」，允许实现秩而内上的能力。\",\n    formula: null,\n    prerequisites: [\"order\"],\n    related: [\"exo_nomic\"],\n    examples: [\"一个秩序中内在的创作倾向\"],\n    source: \"「The Infinity」文本中关于秩序与律令的论述\"\n  },\n\n  exo_nomic: {\n    id: \"exo_nomic\",\n    name: \"秩而外上 (Exo-nomic)\",\n    type: \"前置概念\",\n    definition: \"秩而外上形容的是与某种创作姿态能够追求充分关联的、外在于其关乎事项的对象。它的「外」体现在普遍的「外」——不沿某一具体参考系触发，而是有任意多方向甚至任意多的向度。秩而外上通往的世界至少对应一整个「间性」（即普遍关联的世界）。\",\n    formula: null,\n    prerequisites: [\"order\", \"endo_nomic\"],\n    related: [],\n    examples: [\"从外部对一个秩序整体进行描述的外部视角\"],\n    source: \"「The Infinity」文本中关于秩而外上的论述\"\n  },\n\n  order: {\n    id: \"order\",\n    name: \"秩序 (Order)\",\n    type: \"前置概念\",\n    definition: \"秩序是关于对象显像的规律。秩序需要可演效及奏效的属性，并且必须为秩序下的对象服务。秩序中的「显象」姿态是可协调的、可关联、可交流的，这些「可」之准许出发于规律的自然形象，从而形成「秩序自然」。跨越秩序间不同层义的显象，其性质无法由单一具体秩序的显象直接归类。\",\n    formula: null,\n    prerequisites: [],\n    related: [],\n    examples: [\"数学的公理体系\", \"物理学的自然法则\", \"逻辑的推理规则\"],\n    source: \"「The Infinity」文本中的秩序论\"\n  }\n};\n\n// ============================================================\n// RENDERING ENGINE\n// ============================================================\nconst state = { current: \"root\", history: [\"root\"] };\n\nfunction getPrereqCount(id) {\n  const c = concepts[id];\n  if (!c) return 0;\n  return (c.prerequisites || []).length;\n}\n\nfunction render() {\n  const id = state.current;\n  const c = concepts[id];\n  if (!c) return;\n\n  // Breadcrumb\n  const bc = document.getElementById('breadcrumb');\n  bc.innerHTML = state.history.map((h, i) => {\n    const node = concepts[h];\n    if (i === state.history.length - 1) {\n      return `<span class=\"bc-current\">${escHtml(node.name)}</span>`;\n    }\n    return `<span class=\"bc-item\" onclick=\"goTo('${h}')\">${escHtml(node.name)}</span><span class=\"bc-sep\">›</span>`;\n  }).join('');\n\n  // Main content\n  const main = document.getElementById('main');\n  let html = '';\n\n  // Back button\n  if (state.history.length > 1) {\n    const parentId = state.history[state.history.length - 2];\n    const parent = concepts[parentId];\n    html += `<div class=\"back-link\" onclick=\"goBack()\">← 返回「${escHtml(parent.name)}」</div>`;\n  }\n\n  // Type badge\n  let typeClass = 'type-leaf';\n  if (id === 'root') typeClass = 'type-root';\n  else if ((c.prerequisites || []).length === 0) typeClass = 'type-leaf';\n\n  // Concept card\n  html += `<div class=\"concept-card\">`;\n  html += `<div class=\"concept-header\">`;\n  html += `<span class=\"concept-type ${typeClass}\">${escHtml(c.type)}</span>`;\n  html += `<div><div class=\"concept-name\">${escHtml(c.name)}</div>`;\n  html += `<div class=\"concept-meta\">前置依赖：${(c.prerequisites||[]).length} 个概念</div></div>`;\n  html += `</div>`;\n\n  // Definition\n  html += `<div class=\"concept-def\">${escHtml(c.definition)}</div>`;\n\n  // Formula\n  if (c.formula) {\n    html += `<div class=\"concept-formula\">${escHtml(c.formula)}`;\n    if (c.formula_note) html += `<div class=\"formula-note\">${escHtml(c.formula_note)}</div>`;\n    html += `</div>`;\n  }\n\n  // Prerequisites\n  if (c.prerequisites && c.prerequisites.length > 0) {\n    html += `<div class=\"concept-section\">`;\n    html += `<div class=\"concept-section-title\">前置依赖（可点击探索）</div>`;\n    html += `<div class=\"preq-grid\">`;\n    c.prerequisites.forEach(pid => {\n      const pc = concepts[pid];\n      if (!pc) return;\n      const prereqCount = getPrereqCount(pid);\n      const isLeaf = prereqCount === 0;\n      html += `<div class=\"preq-card${isLeaf ? ' leaf' : ''}\" ${isLeaf ? 'tabindex=\"0\"' : `onclick=\"goTo('${pid}')\" tabindex=\"0\"`} ${isLeaf ? '' : `role=\"button\" aria-label=\"查看${escHtml(pc.name)}\"`} onkeydown=\"if(event.key==='Enter')goTo('${pid}')\">`;\n      html += `<div class=\"preq-card-name\">${escHtml(pc.name)}</div>`;\n      html += `<div class=\"preq-card-type\">${escHtml(pc.type)}</div>`;\n      html += `<div class=\"preq-card-count\">${isLeaf ? '叶节点' : `${prereqCount} 个前置概念`}</div>`;\n      html += `</div>`;\n    });\n    html += `</div>`;\n    html += `</div>`;\n  } else {\n    html += `<div class=\"leaf-notice\">当前预览中没有继续拆分的前置概念。</div>`;\n  }\n\n  // Related concepts\n  if (c.related && c.related.length > 0) {\n    html += `<div class=\"concept-section\">`;\n    html += `<div class=\"concept-section-title\">对照/相关概念</div>`;\n    html += `<div class=\"related-list\">`;\n    c.related.forEach(rid => {\n      const rc = concepts[rid];\n      if (!rc) return;\n      html += `<span class=\"related-tag\" onclick=\"goTo('${rid}')\" tabindex=\"0\" onkeydown=\"if(event.key==='Enter')goTo('${rid}')\">${escHtml(rc.name)}</span>`;\n    });\n    html += `</div></div>`;\n  }\n\n  // Examples\n  if (c.examples && c.examples.length > 0) {\n    html += `<div class=\"concept-section\">`;\n    html += `<div class=\"concept-section-title\">例子</div>`;\n    html += `<div class=\"concept-examples\">`;\n    c.examples.forEach(ex => { html += `<div>• ${escHtml(ex)}</div>`; });\n    html += `</div></div>`;\n  }\n\n  // Source\n  if (c.source) {\n    html += `<div class=\"concept-source\">来源：${escHtml(c.source)}</div>`;\n  }\n\n  html += `</div>`;\n  main.innerHTML = html;\n  window.scrollTo(0, 0);\n}\n\nfunction goTo(id) {\n  state.current = id;\n  state.history.push(id);\n  render();\n}\n\nfunction goBack() {\n  if (state.history.length > 1) {\n    state.history.pop();\n    state.current = state.history[state.history.length - 1];\n    render();\n  }\n}\n\nfunction goRoot() {\n  state.current = \"root\";\n  state.history = [\"root\"];\n  render();\n}\n\nfunction escHtml(s) {\n  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');\n}\n\n// Init\nrender();\n</script>\n</body>\n</html>\n"
}